    {
      "parameters": {
        "jsCode": "const raw=String($json.output||$json.text||'');\nlet parsed={};try {parsed=JSON.parse(raw.replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,'').trim());} catch(e){}\nconst original=$('Validar entrada').first().json;\nconst acciones=['responder','derivar'];\nconst categorias=['envios','pagos','cambios','devoluciones','otros'];\nlet accion=acciones.includes(parsed.accion)?parsed.accion:'derivar';\nlet respuesta=typeof parsed.respuesta==='string'?parsed.respuesta.trim():'';\nif (!respuesta || respuesta.length>800) accion='derivar';\nif (accion==='derivar') respuesta='Tu consulta necesita revisión. La registramos para que la vea una persona del equipo de atención.';\nreturn [{json:{numero:original.numero,pregunta:original.pregunta,accion,categoria:categorias.includes(parsed.categoria)?parsed.categoria:'otros',motivo:typeof parsed.motivo==='string'?parsed.motivo.slice(0,200):'Revisión por datos ambiguos o formato inválido',respuesta,fecha:new Date().toISOString()}}];"
