    {
      "parameters": {
        "jsCode": "const rows=$input.all().map(x=>x.json);\nconst datos=rows.filter(x=>typeof x.clave==='string' && typeof x.valor==='string' && x.clave.trim() && x.valor.trim());\nconst entr=$('Validar entrada').first().json;\nconst listo=datos.length>0 && !rows.some(x=>x.error);\nreturn [{json:{...entr,datos_operativos:datos.map(x=>x.clave+': '+x.valor).join('\\n').slice(0,2000),fuente_ok:listo,respuesta:listo?'':'Los datos del servicio no están disponibles. Por favor, intentá más tarde.'}}];"
