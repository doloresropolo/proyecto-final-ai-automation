        "jsCode": "const q=$json.query||{};\nconst pregunta=String(q.pregunta||'').trim();\nconst numero=String(q.numero||'').trim();\nconst valido=pregunta.length>=5 && pregunta.length<=600 && /^[a-zA-Z0-9_+\\-]{3,40}$/.test(numero);\nreturn [{json:{pregunta,numero,valido,respuesta:valido?'':'Faltan datos válidos: enviá pregunta y numero de remitente.'}}];"
